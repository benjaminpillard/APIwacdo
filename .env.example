# Copier ce fichier en .env puis remplir les valeurs.

# Clé de signature des tokens JWT : longue et aléatoire, jamais commitée.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-moi
ALGORITHM=HS256

# SQLite en développement, PostgreSQL en production (Render fournit l'URL)
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://user:motdepasse@hote:5432/wacdo

# Origines du front autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
